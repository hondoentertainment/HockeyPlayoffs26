# Required: a single shared password gating /admin
ADMIN_PASSWORD=change-me

# Required: signing secret for the admin session cookie (any 32+ char random string)
ADMIN_COOKIE_SECRET=change-me-to-a-long-random-string

# Postgres connection string. On Vercel, link a Neon Postgres store from the
# Storage tab and the DATABASE_URL is injected automatically. POSTGRES_URL is
# accepted as a fallback (Vercel's older convention).
DATABASE_URL=
